# Backend endpoints
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_WS_URL=wss://api.example.com/chat

# Firebase Web app configuration used by the Firebase JavaScript SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Google OAuth clients from the same Firebase/Google Cloud project
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# StoreKit catalog fallback. The authenticated backend catalog is authoritative.
EXPO_PUBLIC_APPLE_SUBSCRIPTION_PRODUCT_IDS=com.chilltech.pantrio.subscription.monthly,com.chilltech.pantrio.subscription.yearly

# Public legal pages shown with the subscription offer
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_OF_USE_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/

# Build-only secret. Configure it with EAS visibility "Secret" in each build
# environment that uploads Sentry source maps. Never commit a real value.
SENTRY_AUTH_TOKEN=
